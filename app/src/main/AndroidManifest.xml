<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Conexión ADB local (127.0.0.1:5555) para los comandos con permisos de shell. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ecualizador plano sobre la mezcla general (sesión 0) que controla el volumen, ADR-013. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Ver las apps de TV instaladas (nombre, banner y cómo abrirlas) para el panel de apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Volumen Maestro"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Panel de apps abiertas (botón TCL Home). Tarea aparte, translúcida y fuera de recientes,
             para no traer al frente la pantalla principal de la app. -->
        <activity
            android:name=".recientes.RecentsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="local.volumenmaestro.recientes"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- El motor vive en su propio proceso, liviano y sin Compose. El servicio conserva
             el nombre de la versión 1 para que siga habilitado después de actualizar. -->
        <service
            android:name=".VolumeService"
            android:exported="true"
            android:label="Volumen Maestro"
            android:process=":motor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:process=":motor" />
    </application>
</manifest>
