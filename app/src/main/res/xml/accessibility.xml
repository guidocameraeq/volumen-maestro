<?xml version="1.0" encoding="utf-8"?>
<!-- Sin filtro de teclas: con él, Android deja de repetir las teclas mantenidas y el volumen
     sube o baja de a un paso. El atajo del control se escucha con getevent (ver Engine). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/descripcion" />
